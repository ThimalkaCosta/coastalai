rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection — users can read/write their own doc;
    // Head Office and Manager can read all users; Head Office can update all;
    // Manager can update only Officer-level users
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Head Office' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Manager' &&
          (resource.data.role == 'Officer' || resource.data.status == 'pending')
        )
      );
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Head Office' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Manager' &&
          (resource.data.role == 'Officer' || resource.data.status == 'pending')
        )
      );
    }

    // ── Conversations — any authenticated participant can read/write ──
    match /conversations/{convoId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;
      allow update, delete: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      // Messages sub-collection
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participantIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // All other collections — authenticated users can read; Managers and Head Office can write
    match /{collection}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Manager' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Head Office'
      );
    }
  }
}
